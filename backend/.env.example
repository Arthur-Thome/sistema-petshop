PORT=3001

DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=amores_pet_homologacao
DB_USER=amores_pet_homologacao_app
DB_PASSWORD=

# Alternativa para PostgreSQL remoto/Neon; quando definida, substitui DB_*.
DATABASE_URL=
# auto habilita TLS para hosts remotos; use verify-full como configuracao explicita.
DB_SSL=auto
# Pool serverless pequeno (padrao 3); local padrao 10.
DB_POOL_MAX=
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=

# Files locais por padrao. Em S3, use buckets separados: pets privado e galeria publico.
FILE_STORAGE_MODE=local
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
PET_PHOTO_BUCKET=
SITE_GALLERY_BUCKET=
# Habilite somente apos homologar o coletor, o DELETE no bucket e a autorizacao direta.
S3_TEMP_UPLOAD_CLEANUP_CONFIRMED=false

JWT_SECRET=
JWT_EXPIRES_IN=8h

# Obrigatorio para desafios por e-mail; gere uma chave aleatoria com pelo menos 32 bytes.
CLIENTE_PUBLICO_PEPPER=

ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_SENHA=

PIX_CHAVE=
PIX_NOME_RECEBEDOR=
PIX_CIDADE=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD= 

# WhatsApp Business Cloud API e opcional; padrao manual nao envia mensagens.
WHATSAPP_TRANSPORT=manual
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

FRONTEND_URL=http://localhost:5173

# Rate limiter distribuido: opcional; na ausencia usa HMAC derivado de JWT_SECRET.
RATE_LIMIT_HMAC_SECRET=

# Obrigatorio para executar manual/cron de limpeza de uploads S3.
CRON_SECRET=
